# Copy to .env (or export) to override defaults.
PORT=8080
LOG_LEVEL=info

# Use an external Postgres instead of the embedded one:
# DATABASE_URL=postgres://user:pass@host:5432/vitals

# Embedded postgres
EMBEDDED_PG_DIR=.data/pg
EMBEDDED_PG_PORT=54329

# Failure-detection tuning (see README)
HEARTBEAT_INTERVAL_MS=1500
HEARTBEAT_TIMEOUT_MS=5000
LEASE_TIMEOUT_MS=7000
REAPER_INTERVAL_MS=1000
SCHEDULER_INTERVAL_MS=500

# Worker tuning
CLAIM_POLL_MS=400
RETRY_BACKOFF_BASE_MS=1000
RETRY_BACKOFF_CAP_MS=30000
MAX_ATTEMPTS_DEFAULT=3

# Disable the demo/chaos endpoints in "production"
CHAOS_ENABLED=true
